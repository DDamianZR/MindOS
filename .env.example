# === MindOS · variables de entorno ===
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

# Entorno: development | production
MINDOS_ENV=production

# --- PostgreSQL ---
POSTGRES_USER=mindos_user
POSTGRES_PASSWORD=cambia_esta_contrasena_fuerte
POSTGRES_DB=mindos_db

# --- Memoria / persistencia ---
DATABASE_TYPE=postgres

# --- Redis (event bus) ---
# (interno del compose; no requiere override normalmente)

# --- Ollama ---
# Ollama corre en el HOST. En Linux/Windows con Docker Desktop: host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Modelos por rol (ver plan/README.md §2)
LLM_MODEL_REASONING=qwen3:8b
LLM_MODEL_EXTRACTION=qwen2.5-coder:14b
LLM_MODEL_RESEARCH=qwen3-coder:30b
LLM_MODEL_FALLBACK=llama3:latest

# --- Ollama en la workstation (opcional, para modelos pesados por LAN) ---
# OLLAMA_URL_WORKSTATION=http://192.168.1.50:11434

# --- Seguridad (se usan a partir de Fase 3: Gateway) ---
# JWT_SECRET=genera_un_secreto_largo_aleatorio
# MINDOS_API_KEY=genera_una_api_key
