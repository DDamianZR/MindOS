# === MindOS · variables de entorno ===
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.

# Entorno: development | production
MINDOS_ENV=production

# --- PostgreSQL ---
POSTGRES_USER=mindos_user
POSTGRES_PASSWORD=cambia_esta_contrasena_fuerte
POSTGRES_DB=mindos_db

# --- Memoria / persistencia ---
DATABASE_TYPE=postgres

# --- Redis (event bus) ---
# (interno del compose; no requiere override normalmente)

# --- Ollama ---
# Ollama corre en el HOST. En Linux/Windows con Docker Desktop: host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Modelos por rol (ver plan/README.md §2)
LLM_MODEL_REASONING=qwen3:8b
LLM_MODEL_EXTRACTION=qwen2.5-coder:14b
LLM_MODEL_RESEARCH=qwen3-coder:30b
LLM_MODEL_FALLBACK=llama3:latest

# --- Ollama en la workstation (opcional, para modelos pesados por LAN) ---
# OLLAMA_URL_WORKSTATION=http://192.168.1.50:11434

# --- Seguridad (Fase 3: Gateway) ---
# JWT_SECRET: genera con `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# MINDOS_API_KEY: mismo comando; úsala para llamadas servicio-a-servicio (header X-Api-Key).
# MINDOS_ADMIN_PASSWORD_HASH: genera con `python scripts/hash_password.py` (nunca la contraseña
# en texto plano). MINDOS_ADMIN_USERNAME es el único usuario humano del sistema.
JWT_SECRET=genera_un_secreto_largo_aleatorio
MINDOS_API_KEY=genera_una_api_key
MINDOS_ADMIN_USERNAME=admin
MINDOS_ADMIN_PASSWORD_HASH=genera_con_scripts_hash_password_py

# --- Traefik / TLS (Fase 3: solo Traefik queda expuesto al host, ver infra/docker-compose.yml) ---
# Déjalo vacío para LAN sin dominio (Traefik sirve su certificado autofirmado, TLS sigue activo).
# Si tienes un dominio real con DNS apuntando a este host y el puerto 80 alcanzable desde
# internet, ponlo aquí para que Traefik emita un certificado Let's Encrypt real automáticamente.
# MINDOS_ACME_EMAIL=tu-email@ejemplo.com
